<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hotel Booking Confirmation</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #fbf7f5;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      border: 1px solid #ccc;
      background-color: #ffffff
    }

    .header {
      background-color: #003366;
      color: white;
      text-align: center;
      padding: 20px;
    }

    .details {
      font-size: 16px;
      line-height: 1.6;
    }

    .cta-button {
      display: block;
      margin-top: 20px;
      text-align: center;
      font-weight: bold;
      text-decoration: none;
      color: #345C72;
    }

    .p1 {
      margin: 20px 0px 0px 0px;
      ;
      padding: 0;
      text-align: center;
    }

    .p2 {
      margin: 0px;
      padding: 0px 20px 0px 0px;
      text-align: center;
    }

    .p3 {
      margin: 0px;
      padding: 30px 0px 0px 0px;
      text-align: center;
      line-widtht: 1.5;
      word-wrap: break-word;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      {{#if status}}
      {{#if (eq status "success")}}
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white">
        <path d="M0 0h24v24H0z" fill="none" />
        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21.71 6.29 20.29 4.88 9 16.17z" />
      </svg>
      {{else if (eq status "failed")}}
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#ffffff" viewBox="0 0 64 64">
        <path d="M32.085,56.058c6.165,-0.059 12.268,-2.619 16.657,-6.966c5.213,-5.164 7.897,-12.803 6.961,-20.096
           c-1.605,-12.499 -11.855,-20.98 -23.772,-20.98c-9.053,0 -17.853,5.677 -21.713,13.909c-2.955,6.302 -2.96,13.911 0,20.225
           c3.832,8.174 12.488,13.821 21.559,13.908c0.103,0.001 0.205,0.001 0.308,0Zm-0.282,-4.003
           c-9.208,-0.089 -17.799,-7.227 -19.508,-16.378c-1.204,-6.452 1.07,-13.433 5.805,-18.015c5.53,-5.35 14.22,-7.143 21.445,-4.11
           c6.466,2.714 11.304,9.014 12.196,15.955c0.764,5.949 -1.366,12.184 -5.551,16.48c-3.672,3.767 -8.82,6.016 -14.131,6.068
           c-0.085,0 -0.171,0 -0.256,0Zm-12.382,-10.29l9.734,-9.734l-9.744,-9.744l2.804,-2.803l9.744,9.744l10.078,-10.078l2.808,2.807
           l-10.078,10.079l10.098,10.098l-2.803,2.804l-10.099,-10.099l-9.734,9.734l-2.808,-2.808Z" />
      </svg>
      {{/if}}
      {{/if}}

      <h1>{{title}}</h1>
    </div>

    <div class="details">
      <p>{{newlineToBr body}}</p>
      <p>If you have any questions or concerns, feel free to contact our support team.<BR><BR>

        Best regards,<BR>
        Triplaye Team</p>

    </div>
    {{!-- <a href="[Your Website URL]" class="cta-button">View details on [website]</a> --}}
  </div>
  <footer>
    <p class="p1">© {{copyRightYear}} Triplaye</p>
    <p class="p2">This email was sent by Triplaye.com
      {{!-- <br />
    <p class="p3">Gojobooking.com will recieve and process replies to this email as <br />set forth in the <a
        href="">privacy statment.</a> The content of <br /> the message from
      gojobooking.com was not generated by it, which means that it <br /> cannot be held accountable for the content of
      the message.
    </p> --}}
  </footer>
</body>

</html>