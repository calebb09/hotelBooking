<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>Triplaye Travel</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background-color: #f5f8fa;
      color: #333;
    }

    .container {
      width: 100%;
      max-width: 640px;
      margin: auto;
      background-color: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    .header {
      background-color: #372F2B;
      text-align: center;
      padding: 10px;
    }

    .header img {
      max-width: 150px;
    }

    .main {
      padding: 24px;
    }

    .main h1 {
      color: #0088cc;
      font-size: 24px;
      margin-bottom: 16px;
    }

    .main p {
      font-size: 16px;
      line-height: 1.6;
    }

    .cta-btn {
      display: inline-block;
      background-color: #ff6600;
      color: #fff;
      padding: 14px 24px;
      text-decoration: none;
      border-radius: 4px;
      font-weight: bold;
      margin-top: 20px;
    }

    .footer {
      text-align: center;
      padding: 16px;
      font-size: 12px;
      color: #777;
    }
  </style>
</head>

<body>
  <div class="container">
    <!-- Header with logo -->
    <div class="header">
      <!-- Fallback text if the logo doesn't load -->
      <img src="https://triplaye.com/assets/icons/triplay_logo.png" alt="Triplaye Logo"
        onerror="this.style.display='none';" />
    </div>

    <!-- Main content -->
    <div class="main">
      <h1>{{title}}</h1>
      {{#if status}}
      {{#if (eq status "success")}}
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="white">
        <path d="M0 0h24v24H0z" fill="none" />
        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21.71 6.29 20.29 4.88 9 16.17z" />
      </svg>
      {{else if (eq status "failed")}}
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#ffffff" viewBox="0 0 64 64">
        <path d="M32.085,56.058c6.165,-0.059 12.268,-2.619 16.657,-6.966c5.213,-5.164 7.897,-12.803 6.961,-20.096
           c-1.605,-12.499 -11.855,-20.98 -23.772,-20.98c-9.053,0 -17.853,5.677 -21.713,13.909c-2.955,6.302 -2.96,13.911 0,20.225
           c3.832,8.174 12.488,13.821 21.559,13.908c0.103,0.001 0.205,0.001 0.308,0Zm-0.282,-4.003
           c-9.208,-0.089 -17.799,-7.227 -19.508,-16.378c-1.204,-6.452 1.07,-13.433 5.805,-18.015c5.53,-5.35 14.22,-7.143 21.445,-4.11
           c6.466,2.714 11.304,9.014 12.196,15.955c0.764,5.949 -1.366,12.184 -5.551,16.48c-3.672,3.767 -8.82,6.016 -14.131,6.068
           c-0.085,0 -0.171,0 -0.256,0Zm-12.382,-10.29l9.734,-9.734l-9.744,-9.744l2.804,-2.803l9.744,9.744l10.078,-10.078l2.808,2.807
           l-10.078,10.079l10.098,10.098l-2.803,2.804l-10.099,-10.099l-9.734,9.734l-2.808,-2.808Z" />
      </svg>
      {{/if}}
      {{/if}}
      <p>Hi <strong>{{customer_name}}</strong>,</p>
      <p>
        {{newlineToBr body}}
      </p>
      <p>
        From personalized itineraries to travel tips and up-to-the-minute plans, we’re committed
        to making your trip planning effortless and exciting.
      </p>

      <a href="{{cta_link}}" class="cta-btn">Start Planning Now</a>
    </div>

    <!-- Footer note -->
    <div class="footer">
      You’re receiving this email because you subscribed to Triplaye travel services.<br />
      If you’d like to unsubscribe, click here: <a href="{{unsubscribe_link}}">Unsubscribe</a>
      <br>© {{copyRightYear}} Triplaye.com
    </div>
  </div>
</body>

</html>